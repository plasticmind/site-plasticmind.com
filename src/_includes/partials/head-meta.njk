<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {#- = Page facts shared by the tags below #}
    {%- set isPost = page.inputPath and page.inputPath.includes('/content/posts/') %}
    {%- set metaDescription = description or meta_description or excerpt or subtitle %}
    {%- if not metaDescription and isPost %}{% set metaDescription = page.inputPath | describe %}{% endif %}
    {%- if not metaDescription %}{% set metaDescription = site.description %}{% endif %}
    {%- set metaDescription = metaDescription | striptags | trim %}
    {#- Only listings split across pages get a page number; tag pages paginate one tag per page. #}
    {%- set pageNumber = pagination.pageNumber if (pagination and pagination.size > 1 and pagination.pageNumber) else 0 %}
    {%- if pageNumber > 0 %}{% set metaDescription = metaDescription ~ " Page " ~ (pageNumber + 1) ~ "." %}{% endif %}
    {%- if seo_title %}
      {%- set docTitle = seo_title %}
    {%- elif title and section != 'home' %}
      {%- set docTitle = (title | striptags) ~ (" (page " ~ (pageNumber + 1) ~ ")" if pageNumber > 0 else "") ~ " → " ~ site.title %}
    {%- else %}
      {%- set docTitle = site.title %}
    {%- endif %}
    {%- set shareTitle = (seo_title or title or site.title) | striptags %}
    {%- set ownImage = featured_image_url or ((page.inputPath | firstImage) if isPost else "") %}
    {%- set shareImage = (ownImage | absoluteUrl(site.url)) if ownImage else (site.url ~ "/assets/img/logo-plasticmind-open-graph.png") %}
    {%- set canonicalUrl = site.url ~ page.url %}

    <title>{{ docTitle }}</title>
    <meta name="description" content="{{ metaDescription }}">
    <meta name="author" content="{{ site.author.name }}">
    <link rel="canonical" href="{{ canonicalUrl }}">
    <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml">

    <meta property="og:title" content="{{ shareTitle }}">
    <meta property="og:description" content="{{ metaDescription }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <meta property="og:type" content="{{ ogtype or 'website' }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:image" content="{{ shareImage }}">
    {%- if ownImage %}
    <meta property="og:image:alt" content="{{ (alt_text or title) | striptags }}">
    {%- else %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Plasticmind">
    {%- endif %}
    {%- if isPost %}
    <meta property="article:published_time" content="{{ date | dateISO }}">
    <meta property="article:author" content="{{ site.url }}/">
    {%- if primary_category %}
    <meta property="article:section" content="{{ primary_category }}">
    {%- endif %}
    {%- for tag in tags %}
    <meta property="article:tag" content="{{ tag }}">
    {%- endfor %}
    {%- endif %}

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="{{ site.twitter }}">
    <meta name="twitter:creator" content="{{ site.twitter }}">
    <meta name="twitter:title" content="{{ shareTitle }}">
    <meta name="twitter:description" content="{{ metaDescription }}">
    <meta name="twitter:image" content="{{ shareImage }}">

    {% include "partials/structured-data.njk" %}

    <link rel="preload" href="/assets/fonts/instrument-sans-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/bricolage-grotesque-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/assets/css/fonts.css">
    <link rel="stylesheet" href="/assets/css/global.css">
    <link rel="stylesheet" href="/assets/css/prism.css">

    {%- if site.googleAnalyticsId %}
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', '{{ site.googleAnalyticsId }}');
      // Google Analytics loads after the page does, so it never competes
      // with the content for bandwidth. Events queue in dataLayer until then.
      addEventListener('load', function () {
        var load = function () {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtag/js?id={{ site.googleAnalyticsId }}';
          document.head.appendChild(script);
        };
        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
        else setTimeout(load, 0);
      });
    </script>
    {%- endif %}
